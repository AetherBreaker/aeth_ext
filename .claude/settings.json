                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_edit_protect.py\"",
                        "shell": "bash"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_bash_protect_deps.py\"",
                        "shell": "bash"
                    }
                ]
            }
        ],
        "Stop": [
