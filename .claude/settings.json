                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_ruff.py\"",
                        "shell": "bash",
                        "timeout": 30
                    },
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_pyright.py\"",
                        "shell": "bash",
                        "timeout": 60
                    }
